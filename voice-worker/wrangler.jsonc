{
  "name": "gym-tracker-voice",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://keiton212.github.io",
    "TRANSCRIBE_MODEL": "gpt-4o-transcribe",
    "PARSE_MODEL": "gpt-4.1-mini"
  },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "VoiceBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceBudget"] }],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": false }
}
